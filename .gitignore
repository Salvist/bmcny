# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Keep local Supabase files ignored while including the prayer request migration.
/supabase/*
!/supabase/migrations/
/supabase/migrations/*
!/supabase/migrations/*_create_prayer_requests.sql
!/supabase/migrations/20261107195000_update_prayer_request_fields.sql
/assets
